{
  "name": "hafaclip",
  "version": "3.2.0",
  "description": "Clipboard manager for Windows that lives on the screen edge and expands on hover.",
  "author": "Ali Alhumedi",
  "license": "MIT",
  "homepage": "https://github.com/alimwork85-web/hafaclip",
  "repository": {
    "type": "git",
    "url": "https://github.com/alimwork85-web/hafaclip.git"
  },
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node --test test/*.test.mjs",
    "e2e": "node test/e2e/app.e2e.mjs",
    "icon": "electron scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "local.edge-clipboard",
    "productName": "HafaClip",
    "copyright": "© 2026 Ali Alhumedi",
    "electronLanguages": [
      "en-US",
      "ar"
    ],
    "compression": "maximum",
    "files": [
      "out/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "HafaClip"
    }
  },
  "dependencies": {
    "koffi": "^3.3.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "emojibase-data": "^18.0.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  }
}
